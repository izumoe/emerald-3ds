--- a/asm/macros/event.inc
+++ b/asm/macros/event.inc
@@ -1997,3 +1997,33 @@
     special Port_CameraEnd
     .endm
 #endif
+
+#ifdef PORT_BRIDGE
+    @ Scenic sequences own the camera and allow B to skip the whole sequence.
+    .macro camera_scene
+    special Port_CameraScene
+    .endm
+    @ Current-map tile coordinates, independent of actors.
+    .macro camera_anchor x:req, y:req
+    setvar VAR_0x8004, \x
+    setvar VAR_0x8005, \y
+    special Port_CameraAnchor
+    .endm
+    @ Absolute scenic pitch/yaw; distance remains relative to gameplay.
+    .macro camera_view frames:req, distance=150, pitch=45, yaw=0
+    setvar VAR_0x8006, \frames
+    setvar VAR_0x8007, \distance
+    setvar VAR_0x8008, \pitch
+    setvar VAR_0x8009, \yaw
+    special Port_CameraView
+    .endm
+#endif
+
+#ifdef PORT_BRIDGE
+    @ Hold the displayed camera; B can still skip the scenic sequence.
+    .macro camera_hold frames=120
+    setvar VAR_0x8006, \frames
+    special Port_CameraHold
+    waitstate
+    .endm
+#endif
