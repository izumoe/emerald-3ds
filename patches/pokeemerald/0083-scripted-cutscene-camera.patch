+    camera_offset 0, -20
+    camera_move 96, 112, -4, -30
+    applymovement LOCALID_OLDALE_MART_EMPLOYEE, OldaleTown_Movement_CameraLookAtMart
+    waitmovement 0
+    waitcamera
+    msgbox OldaleTown_Text_CameraBlueRoof, MSGBOX_DEFAULT
