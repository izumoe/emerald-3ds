+#ifdef PORT_BRIDGE
+    @ Camera macros reserve scratch variables 0x8004 through 0x8009.
+    .macro camera_pair actor1:req, actor2:req
+    setvar VAR_0x8004, \actor1
+    setvar VAR_0x8005, \actor2
+    special Port_CameraPair
+    .endm
+    .macro camera_move frames:req, distance=100, pitch=0, yaw=0
+    setvar VAR_0x8006, \frames
+    setvar VAR_0x8007, \distance
+    setvar VAR_0x8008, \pitch
+    setvar VAR_0x8009, \yaw
+    special Port_CameraMove
+    .endm
+    @ Target offset in sixteenths of a world tile; set before camera_move.
+    @ Azimuth heading: 90 is the usual front view, 150 is a 60-degree orbit.
+    .macro camera_orbit frames:req, distance=80, pitch=4, heading=150
+    setvar VAR_0x8006, \frames
+    setvar VAR_0x8007, \distance
+    setvar VAR_0x8008, \pitch
+    setvar VAR_0x8009, \heading
+    special Port_CameraOrbit
+    .endm
+    .macro camera_offset x=0, z=0
+    setvar VAR_0x8006, \x
+    setvar VAR_0x8007, \z
+    special Port_CameraOffset
+    .endm
+    .macro camera_follow enabled=TRUE
+    setvar VAR_0x8006, \enabled
+    special Port_CameraFollow
+    .endm
+    .macro waitcamera
+    special Port_CameraWait
+    waitstate
+    .endm
+    .macro camera_return frames=60
+    setvar VAR_0x8006, \frames
+    special Port_CameraReturn
+    .endm
+    .macro camera_end
+    special Port_CameraEnd
+    .endm
+#endif
